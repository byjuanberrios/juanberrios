---
const { title } = Astro.props;
---

<div
  role="note"
  class="message font-sans relative py-5 px-5 rounded-lg mt-7 mb-8 bg-stone-200 dark:bg-zinc-800 border-[0.05rem] border-stone-300 dark:border-zinc-700 overflow-hidden"
>
  <p class="font-semibold mt-0 mb-1 text-sm relative z-[1]">
    {title || "Nota"}
  </p>
  <div
    class="message-body text-sm text-zinc-700 dark:text-zinc-400 relative z-[1]"
  >
    <slot />
  </div>
</div>
