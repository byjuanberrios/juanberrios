---
const { name, image, note, price, links } = Astro.props;
---

<article
  class="wishlist-item flex gap-3 md:gap-4 p-2.5 md:p-3 rounded-xl border border-zinc-200/70 dark:border-neutral-700/60 bg-linear-to-b from-zinc-100 to-zinc-50 dark:from-neutral-800/70 dark:to-neutral-900/40 font-sans"
>
  {
    image && (
      <img
        src={image}
        alt={name}
        width="256"
        height="256"
        loading="lazy"
        class="my-0 shrink-0 size-24 md:size-28 object-contain rounded-lg bg-white"
      />
    )
  }
  <div class="flex flex-col min-w-0 gap-2 py-0.5">
    <div>
      <h3 class="m-0 text-sm md:text-base leading-snug text-pretty">
        {name}
      </h3>
      {
        (note || price) && (
          <p class="mt-0.5 mb-0 text-xs md:text-sm text-zinc-600 dark:text-zinc-400">
            {[note, price].filter(Boolean).join(" · ")}
          </p>
        )
      }
    </div>
    <div class="flex flex-wrap gap-1.5 mt-auto">
      {
        links.map((link: { store: string; url: string }) => (
          <a
            href={link.url}
            class="no-underline before:hidden text-xs md:text-sm font-medium px-2.5 py-0.5 rounded-full border border-zinc-300 dark:border-neutral-600 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-200/70 dark:hover:bg-neutral-700/60 transition-colors"
            rel="noreferrer noopener"
            target="_blank"
          >
            {link.store} ↗
          </a>
        ))
      }
    </div>
  </div>
</article>
